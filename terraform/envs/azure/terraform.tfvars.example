subscription_id     = "00000000-0000-0000-0000-000000000000"
cluster_name        = "scalesafe-prod"
location            = "centralindia"
ssh_public_key_path = "~/.ssh/id_ed25519.pub"

# Who may SSH / reach the Kubernetes API (your office/VPN IPs). Never 0.0.0.0/0.
admin_cidrs = ["203.0.113.10/32"]

# Who may reach 80/443. Behind Cloudflare proxy: Cloudflare ranges only (www.cloudflare.com/ips-v4).
web_cidrs = [
  "173.245.48.0/20", "103.21.244.0/22", "103.22.200.0/22", "103.31.4.0/22",
  "141.101.64.0/18", "108.162.192.0/18", "190.93.240.0/20", "188.114.96.0/20",
  "197.234.240.0/22", "198.41.128.0/17", "162.158.0.0/15", "104.16.0.0/13",
  "104.24.0.0/14", "172.64.0.0/13", "131.0.72.0/22",
]

# B2s is frequently capacity-restricted in centralindia; B2as_v2 worked in the quick test.
server_size = "Standard_B2as_v2"
agent_size  = "Standard_B2as_v2"
agent_count = 1
